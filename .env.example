# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Verified sending identity on a domain you own in Resend.
RESEND_FROM_EMAIL="Moonbag.ai <hello@moonbag.ai>"

# Where waitlist signup notifications are delivered.
# Comma-separate for multiple recipients.
WAITLIST_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Login — Clerk (https://dashboard.clerk.com → your app → API Keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Only these emails can open the Moonbag desk (comma-separated).
MOONBAG_OWNER_EMAILS=

# ---------------------------------------------------------------------------
# Database — Supabase (Project Settings → API). SERVER-SIDE ONLY.
# Never prefix the service-role key with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Agent API keys — long random strings you make up (40+ characters).
# Claude uses one, Grok uses the other:  Authorization: Bearer <key>
# ---------------------------------------------------------------------------
MOONBAG_CLAUDE_API_KEY=
MOONBAG_GROK_API_KEY=
