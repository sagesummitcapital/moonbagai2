// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Moonbag Levels (CR-72, 2026-11-11) — Stavros's range levels on any chart, matching moonbag.ai/dashboard/levels.
// Monthly open · previous month open/close · Monday high/low (+ sweeps) · yesterday's high/low.
// Shows only the nearest 2 above and 2 below price, so the chart stays clean. Updates itself at each close.
// Times are UTC, the same as Moonbag (daily close = 5 PM Phoenix).
//@version=5
indicator("Moonbag Levels", overlay = true, max_lines_count = 50, max_labels_count = 50, max_boxes_count = 10)

// ── Inputs ───────────────────────────────────────────────────────────────
nearN      = input.int(2, "Nearest levels each side", minval = 1, maxval = 6)
showAll    = input.bool(false, "Show every level (not just the nearest)")
useMonth   = input.bool(true, "Monthly open + previous month")
useMonday  = input.bool(true, "Monday range")
useDay     = input.bool(true, "Yesterday's high / low")
shadeMon   = input.string("BTC only", "Shade the Monday range", options = ["BTC only", "All coins", "Off"])
markSweeps = input.bool(false, "Show sweep triangles (Monday range swept, closed back inside)")
extendBars = input.int(25, "Line length (bars to the left)", minval = 5, maxval = 200)
cRange     = input.color(color.new(color.white, 35), "Line colour")
cMonday    = input.color(color.new(#36D1DC, 20), "Monday range colour")

// ── Levels (UTC) ─────────────────────────────────────────────────────────
mo  = request.security(syminfo.tickerid, "M", open,     lookahead = barmerge.lookahead_on)
pmo = request.security(syminfo.tickerid, "M", open[1],  lookahead = barmerge.lookahead_on)
pmc = request.security(syminfo.tickerid, "M", close[1], lookahead = barmerge.lookahead_on)
pdh = request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_on)

// Monday range: the high/low of Monday (UTC). Before Monday has closed, last week's Monday is used.
isMon   = dayofweek(time, "UTC") == dayofweek.monday
newWeek = ta.change(time("W")) != 0
var float curH = na
var float curL = na
var float monH = na
var float monL = na
var bool  curDone = false
if newWeek
    curH := na
    curL := na
    curDone := false
if isMon
    curH := na(curH) ? high : math.max(curH, high)
    curL := na(curL) ? low : math.min(curL, low)
if not isMon and not na(curH) and not curDone
    monH := curH
    monL := curL
    curDone := true

// Sweeps: after Monday, a bar trades beyond the Monday range and closes back inside.
afterMon = not isMon and curDone
sweepHi  = markSweeps and useMonday and afterMon and high > monH and close < monH
sweepLo  = markSweeps and useMonday and afterMon and low < monL and close > monL
plotshape(sweepHi, "Swept Monday high", shape.triangledown, location.abovebar, color.new(#fb7185, 0), size = size.tiny)
plotshape(sweepLo, "Swept Monday low",  shape.triangleup,   location.belowbar, color.new(#3EF3A2, 0), size = size.tiny)

// Monday shading
isBTC = syminfo.basecurrency == "BTC"
doShade = useMonday and (shadeMon == "All coins" or (shadeMon == "BTC only" and isBTC))
var box monBox = na

// ── Draw the nearest levels on the last bar ─────────────────────────────
var line[]  lines  = array.new_line()
var label[] labels = array.new_label()

addLevel(float[] ps, string[] ns, float p, string n) =>
    if not na(p)
        array.push(ps, p)
        array.push(ns, n)

if barstate.islast
    for l in lines
        line.delete(l)
    for b in labels
        label.delete(b)
    array.clear(lines)
    array.clear(labels)

    ps = array.new_float()
    ns = array.new_string()
    if useMonth
        addLevel(ps, ns, mo, "Month open")
        addLevel(ps, ns, pmo, "Prev month open")
        if math.abs(pmc - mo) > mo * 0.0005
            addLevel(ps, ns, pmc, "Prev month close")
    if useMonday
        addLevel(ps, ns, monH, "Mon high")
        addLevel(ps, ns, monL, "Mon low")
    if useDay
        addLevel(ps, ns, pdh, "Yday high")
        addLevel(ps, ns, pdl, "Yday low")

    // pick nearest N above and N below the close
    keep = array.new_bool(array.size(ps), showAll)
    if not showAll and array.size(ps) > 0
        for side = 0 to 1
            for k = 1 to nearN
                best = -1
                bestD = 1e308
                for i = 0 to array.size(ps) - 1
                    p = array.get(ps, i)
                    ok = side == 0 ? p > close : p <= close
                    d = math.abs(p - close)
                    if ok and not array.get(keep, i) and d < bestD
                        best := i
                        bestD := d
                if best >= 0
                    array.set(keep, best, true)

    if array.size(ps) > 0
        for i = 0 to array.size(ps) - 1
            if array.get(keep, i)
                p = array.get(ps, i)
                isMonLvl = str.startswith(array.get(ns, i), "Mon")
                col = isMonLvl ? cMonday : cRange
                array.push(lines, line.new(bar_index - extendBars, p, bar_index + 8, p, color = col, width = isMonLvl ? 2 : 1, style = line.style_solid))
                array.push(labels, label.new(bar_index + 8, p, array.get(ns, i) + "  " + str.tostring(p, format.mintick), style = label.style_label_left, color = color.new(color.black, 100), textcolor = col, size = size.small))

    if doShade and not na(monH)
        box.delete(monBox)
        monBox := box.new(bar_index - extendBars, monH, bar_index + 8, monL, border_color = color.new(cMonday, 70), bgcolor = color.new(cMonday, 92))
